{
  "name": "Immutable release tags",
  "target": "tag",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "refs/tags/[0-9][0-9].[0-9][0-9].[0-9][0-9]-*"
      ],
      "exclude": []
    }
  },
  "bypass_actors": [],
  "rules": [
    {
      "type": "update"
    },
    {
      "type": "deletion"
    }
  ]
}
